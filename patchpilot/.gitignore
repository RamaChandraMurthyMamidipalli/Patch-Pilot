```gitignore
# ==========================================
# PATCH-PILOT - COMPLETE GITIGNORE
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.crt
.secrets.baseline

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python packaging
*.egg
*.egg-info/
dist/
build/
.eggs/
wheels/
pip-wheel-metadata/

# Python testing and type checking
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Python virtual environments
venv/
env/
.venv/
ENV/

# Jupyter Notebook
.ipynb_checkpoints/

# Local databases
*.db
*.sqlite
*.sqlite3
*.db-journal

# Machine Learning datasets and artifacts
data/
models/
mlruns/
mlartifacts/
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.keras
*.safetensors
*.pkl
*.joblib

# DVC
/tmp/
.dvc/tmp/

# Node.js dependencies
node_modules/

# Frontend build output
dist/
.next/
.nuxt/
.output/
.cache/
.parcel-cache/
.vite/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Operating system files
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp
*.bak
*.old

# Docker local volumes
postgres_data/
redis_data/
qdrant_data/

# Docker overrides
docker-compose.override.yml

# Local application state
instance/
uploads/
storage/

# Environment-specific configuration
.env.development
.env.production
.env.test

# Local SQLite and application artifacts
*.sqlite3-shm
*.sqlite3-wal
*.db-shm
*.db-wal

# Generated documentation
site/

# OS and editor backups
*.orig
*.rej
```
