# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://patchpilot:patchpilot@localhost:5432/patchpilot
SYNC_DATABASE_URL=postgresql+psycopg2://patchpilot:patchpilot@localhost:5432/patchpilot

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── ML Service ────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001

# ─── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=patchpilot

# ─── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false  # Set to true in production (HTTPS only)

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── LLM Provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini  # gemini | ollama
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ─── Rate Limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SCAN=20/hour
RATE_LIMIT_EXPLAIN=30/hour
RATE_LIMIT_PATCH=20/hour
DAILY_LLM_BUDGET_USD=5.0

# ─── Upload Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=2
MAX_PASTE_MB=1
MAX_ZIP_FILES=200
MAX_ZIP_EXPANDED_MB=50

# ─── Data Retention ────────────────────────────────────────────────────────────
RETENTION_DAYS=30

# ─── Model / KB ────────────────────────────────────────────────────────────────
MODEL_STAGE=Production  # Production | Staging
KB_VERSION=v1

# ─── Admin (demo only – change before deploying) ───────────────────────────────
ADMIN_EMAIL=admin@patchpilot.dev
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DEMO_USER_EMAIL=user@patchpilot.dev
DEMO_USER_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development  # development | production
APP_NAME=PatchPilot
APP_VERSION=0.1.0

# ─── Worker ────────────────────────────────────────────────────────────────────
ARQ_WORKER_CONCURRENCY=4
SCAN_TIMEOUT_SEC=120
ANALYZER_TIMEOUT_SEC=30

# ─── Secrets Redaction ─────────────────────────────────────────────────────────
DETECT_SECRETS_BASELINE=.secrets.baseline
